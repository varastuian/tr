<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Large plane with stitched aerial tiles; pose/size adjustable in parent world include. -->
  <model name="tile_ground">
    <static>true</static>
    <link name="link">
      <visual name="aerial_mosaic">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1600 1600</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>materials/textures/mosaic.png</albedo_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
